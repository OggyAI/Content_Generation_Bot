{
  "name": "content-generation-bot",
  "version": "0.1.0",
  "description": "Semi-automated YouTube POV storytelling production pipeline",
  "main": "dist/pipeline/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "cli": "ts-node src/cli.ts",
    "run:pipeline": "ts-node src/cli.ts run",
    "run:server": "ts-node src/server/index.ts",
    "test:pacing": "ts-node src/test-pacing.ts",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist output/jobs/*"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.3",
    "@aws-sdk/client-s3": "^3.700.0",
    "axios": "^1.7.2",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.2.0",
    "node-fetch": "^3.3.2",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
