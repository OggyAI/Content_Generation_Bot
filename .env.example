# ─── AI / GENERATION ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-6

ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...             # Choose a voice ID from ElevenLabs dashboard
ELEVENLABS_MODEL_ID=eleven_flash_v2_5   # Flash/Turbo = 0.5 credit/char (half cost). Use eleven_multilingual_v2 for max quality.
ELEVENLABS_SPEED=1.0                # 1.0 normal; try 1.1 for faster/tighter narration

RUNWAY_API_KEY=...                  # Optional — premium mode only
RUNWAY_MODEL=gen3a_turbo            # gen3a_turbo | gen3a

# ─── VIDEO ASSEMBLY ───────────────────────────────────────────────────────────
SHOTSTACK_API_KEY=...
SHOTSTACK_ENV=stage                 # stage = sandbox (watermarked, free) | production (= v1, no watermark, paid)

# ─── IMAGE GENERATION ─────────────────────────────────────────────────────────
# IMAGE_BACKBONE picks how the automated pipeline generates images:
#   replicate  = fully automated via REST API (default). Flux backgrounds + Nano Banana
#                / Flux Kontext reference-conditioned character shots. Batch-callable.
#   higgsfield = manifest mode. The visuals stage writes generation_manifest.json and
#                pauses; you fulfil it interactively via the Higgsfield MCP in a Claude
#                Code chat, drop images back, then resume. (Higgsfield MCP cannot be
#                called by a standalone batch process — it's an interactive OAuth tool.)
IMAGE_BACKBONE=replicate

# Replicate — required for IMAGE_BACKBONE=replicate. Token: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=...
NANO_BANANA_MODEL=google/nano-banana   # reference-conditioned model for on-model character scenes
# Channel STYLE-reference image (local path or URL). When set, sheets + scenes render with
# Nano Banana conditioned on it, locking the flat hand-drawn look. Leave empty to use plain Flux.
STYLE_REFERENCE_IMAGE=assets/style/style-anchor.png

# Stability AI — legacy fallback if no Replicate token is set
STABILITY_API_KEY=...
STABILITY_MODEL=stable-diffusion-xl-1024-v1-0

# Higgsfield AI (interactive MCP — connect in Claude Code, not via key):
#   claude mcp add --transport http --scope user higgsfield https://mcp.higgsfield.ai/mcp
# Used for hero shots, character reference sheets, and IMAGE_BACKBONE=higgsfield manifest fulfilment.

# ─── VISUAL QA-AND-SELECT (Master Brief Part 9) ──────────────────────────────
VARIANTS_PER_SCENE=2                 # candidate images generated per scene
VISUAL_QA=true                      # vision LLM scores variants, picks best, retries failures
VISUAL_QA_MIN_SCORE=6               # below this score → one automatic regeneration
RENDER_FPS=30                       # 30 default; 60 = smoother Ken-Burns (slower/pricier render)

# ─── PER-VIDEO CHARACTER DESIGN (auto cast + reference sheets, all on Replicate) ──
AUTO_CHARACTER_DESIGN=true          # design a fresh detailed cast each video from the script
MAX_DETAILED_CHARACTERS=2           # side-character cap per video (crowds stay silhouettes)
CHARACTER_DIRECTION=                # optional: one-line art direction for the whole cast
PROTAGONIST_DETAILED=true           # POV lead is a detailed relatable character with his own sheet (false = blank faceless figure)

# ─── COMIC OVERLAYS (webcomic style) ─────────────────────────────────────────
BUBBLES_ENABLED=true                # quoted dialogue → comic speech bubbles overlaid on scenes
LABELS_ENABLED=true                 # "23" / character-name labels on first appearance
SUBTITLES_ENABLED=false             # burned-in captions (subtitles.srt exported for YouTube CC regardless)
RENDER_GRADE=none                   # none = keep AI images' palette | auto = Shotstack mood filters

# ─── SOUND EFFECTS ────────────────────────────────────────────────────────────
SFX_ENABLED=true                    # generate scene-matched diegetic SFX (ElevenLabs) at key beats
SFX_VOLUME=0.35                     # SFX mix level under narration (0–1)

# ─── STORAGE ──────────────────────────────────────────────────────────────────
STORAGE_PATH=./output               # Local output root
# Optional S3/R2 for asset hosting (required for Shotstack to access assets)
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BASE_URL=                        # Public CDN URL base for assets
S3_ENDPOINT=                        # R2 API endpoint: https://<account_id>.r2.cloudflarestorage.com

# ─── PIPELINE CONTROLS ────────────────────────────────────────────────────────
PRODUCTION_MODE=low-cost            # low-cost | premium
MAX_SCENES=120                      # Hard cap on scene count (sentence-level pacing)
MIN_SCENES=45                       # Minimum scenes (QA check)
TARGET_RUNTIME_MIN=9                # Target video length in minutes
TARGET_RUNTIME_MAX=12
BUDGET_USD=8.00                     # Per-video cost cap (soft)
RETRY_LIMIT=3                       # API retry attempts
RETRY_DELAY_MS=2000                 # Delay between retries

# ─── APPROVAL GATES ───────────────────────────────────────────────────────────
# file   = drop an approval JSON file to continue (default, async-friendly)
# server = HTTP endpoint for approvals (run src/server/index.ts)
APPROVAL_MODE=file

# ─── NARRATION PACING ─────────────────────────────────────────────────────────
WORDS_PER_MINUTE=145                # Estimation FALLBACK only — real audio timestamps take precedence
MIN_SCENE_DURATION_SEC=2.0          # Guardrail: merge sentences shorter than this
MAX_SCENE_DURATION_SEC=5            # Dense webcomic pacing: ~2-5s per image, long sentences split into wide→close→reaction
AUDIO_BATCH_CHARS=2400              # Max characters per ElevenLabs with-timestamps request (stitched sequentially)
USE_WHISPERX=false                  # Optional forced-alignment fallback (needs `whisperx` CLI installed)

# ─── CHANNEL STYLE LOCK ───────────────────────────────────────────────────────
STYLE_BASE=simple minimalist character with blank white oval face and dot eyes, detailed illustrated background, clean line art, digital illustration, widescreen cinematic composition
STYLE_NO=photorealistic human face, realistic portrait, detailed facial features, anime eyes, 3D render, CGI, photograph
